# deploy/targets/example.env — a deploy target for deploy/deploy.sh
# (docs/deploy.md). Copy it to deploy/targets/<name>.env and run
#   make deploy TARGET=<name>          or   deploy/deploy.sh <name>
# Real targets are .gitignored: only this example lives in the repository.
# The file is sourced by bash; plain VAR=value lines.

# Where to log in: user@host of an account with sudo on the server, or
# "local" to treat this machine as the server (tests, docs/deploy.md).
SSH_TARGET=shfd@shf.example.org
# Jump host (ssh -J), optional.
#SSH_JUMP=user@bastion.example.org
# More ssh options, optional (words, e.g. "-i ~/.ssh/deploy_ed25519 -p 2200").
#SSH_OPTS=

# The public URL nginx serves; /healthz, /v1/downloads and the GUI's
# /api/healthz are checked there after the restart.
PUBLIC_URL=https://shf.example.org

# Where versions/<sha> and the symlink current live (docs/server-ssh.md,
# docs/gui.md). The units run $SHFD_PREFIX/current/shfd and
# $GUI_PREFIX/current/bin/shfd-gui.
SHFD_PREFIX=/opt/shfd
GUI_PREFIX=/opt/shfd-gui

# The packages of make release, served by shfd (SHFD_DOWNLOADS). Empty:
# taken from SHFD_DOWNLOADS of the shfd unit.
DOWNLOADS_DIR=/var/lib/shfd/downloads

# versions/ keeps this many newest versions; current and previous always stay.
KEEP_VERSIONS=5

# systemd units restarted for each part, in this order. The first of each
# list is the one whose Environment= is read (SHFD_DOWNLOADS, SHFD_GUI_BASE).
SHFD_SERVICES="shfd shfd-thumbs"
GUI_SERVICES="shfd-gui"

# Optional, with their defaults:
#SHFD_LOCAL_URL=http://127.0.0.1:8443   # shfd, checked on the server
#GUI_LOCAL_URL=http://127.0.0.1:8444    # shfd-gui, checked on the server
#GUI_BASE=/gui                          # default: SHFD_GUI_BASE of the unit, else /gui; empty = root
#GUI_PUBLIC_URL=                        # default: $PUBLIC_URL$GUI_BASE
#CHECK_TIMEOUT=30                       # seconds the checks are retried
#SERVER_PLATFORM=linux/amd64            # GOOS/GOARCH of shfd on the server
#SUDO=sudo                              # empty: no sudo (the login user owns the prefixes)
#SYSTEMCTL=systemctl
